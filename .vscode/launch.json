{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend · FastAPI (uvicorn debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["server:app", "--host", "0.0.0.0", "--port", "8001", "--reload"],
      "cwd": "${workspaceFolder}/backend",
      "jinja": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Backend · pytest (archivo actual)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal"
    }
  ]
}
